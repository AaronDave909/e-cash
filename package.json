{
  "name": "ecash",
  "version": "1.0.0",
  "private": true,
  "description": "E-Cash microservices e-wallet backend",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*", "services/*"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "infra:start": "scripts/dev-infra.sh start",
    "infra:stop": "scripts/dev-infra.sh stop",
    "dev": "scripts/dev.sh start",
    "dev:stop": "scripts/dev.sh stop"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/jsonwebtoken": "^9.0.6",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  }
}
