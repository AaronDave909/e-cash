# Copy to .env and fill in. `docker compose up` reads it.

# Datadog (required by the agent container)
DD_API_KEY=
DD_SITE=datadoghq.com

# Postgres
POSTGRES_PASSWORD=ecash

# Secrets shared by services. Change them outside local use.
JWT_SECRET=change-me-jwt
QR_SECRET=change-me-qr
RAIL_WEBHOOK_SECRET=change-me-rail

# Simulation knobs
ECASH_EXPOSE_OTP=true
# Unauthenticated /api/sim/* routes (Users tab, chaos). Dev and staging only; never true in production.
ECASH_SIMULATOR_ENABLED=true
RAIL_SETTLE_MIN_MS=1500
RAIL_SETTLE_MAX_MS=4000
PENDING_DEADLINE_MS=120000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_S=10
